# ============================================================
# IMPORTANTE: esta VPS já roda outros containers (Evolution API
# e outros). Antes de definir as portas abaixo, confira o que já
# está em uso com: docker ps --format "table {{.Names}}\t{{.Ports}}"
# e ajuste MYSQL_PORT / BACKEND_PORT / FRONTEND_PORT / FRONTEND_SSL_PORT
# para portas livres.
# ============================================================

# MYSQL
MYSQL_ENGINE=mariadb
MYSQL_VERSION=10.6
MYSQL_ROOT_PASSWORD=troque-esta-senha
MYSQL_DATABASE=grcartuchos
MYSQL_PORT=3306
TZ=America/Fortaleza

# BACKEND
BACKEND_PORT=8080
BACKEND_SERVER_NAME=atendimento-api.grcartuchos.com.br
BACKEND_URL=https://atendimento-api.grcartuchos.com.br
PROXY_PORT=443
# Gere valores únicos com: openssl rand -hex 32
JWT_SECRET=troque-este-valor-gerado-com-openssl-rand--hex-32
JWT_REFRESH_SECRET=troque-este-outro-valor-gerado-com-openssl-rand--hex-32

# FRONTEND
FRONTEND_PORT=3000
FRONTEND_SSL_PORT=3001
FRONTEND_SERVER_NAME=atendimento.grcartuchos.com.br
FRONTEND_URL=https://atendimento.grcartuchos.com.br

# BROWSERLESS
MAX_CONCURRENT_SESSIONS=1

# PHPMYADMIN (opcional, só se for usar docker-compose.phpmyadmin.yaml)
PMA_PORT=8081
